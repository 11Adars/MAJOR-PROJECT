# Copy this file to .env and fill in values
# Gmail SMTP example (use App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_app_password_16_chars
PREDICTION_EMAIL_TO=recipient@example.com
SMTP_DEBUG=true
# Optional Gemini
GOOGLE_API_KEY=
ENABLE_SENTENCE_GEN=false
