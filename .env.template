# ============================================
# NS-AGF Banking System - Environment Configuration Template
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to: backend/.env
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env file to Git (already in .gitignore)
# 
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
# 
# For Supabase:
# Get from: Project Settings → Database → Connection String → URI
# Example: postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres
# 
# For Local PostgreSQL:
# Example: postgresql://postgres:yourpassword@localhost:5432/banking_system
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres


# ============================================
# SECURITY CONFIGURATION
# ============================================

# JWT Secret Key (for authentication tokens)
# Generate a strong random key: https://randomkeygen.com/
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_KEY_64_CHARACTERS_OR_MORE


# ============================================
# MICROSERVICES URLS
# ============================================

# Voice Recognition Service (Python/Flask)
PYTHON_SERVICE_URL=http://127.0.0.1:5001/embed

# Biometric Fusion Service (Python/Flask)
NS_AGF_SERVICE_URL=http://127.0.0.1:5002

# Sign Language API Service (Python/Flask)
SIGN_SERVICE_URL=http://127.0.0.1:5003


# ============================================
# SERVER CONFIGURATION
# ============================================

# Backend server port
PORT=5000


# ============================================
# EMAIL CONFIGURATION (Gmail Example)
# ============================================

# User Email Account (sends notifications to customers)
# This email will send confirmation emails to users
EMAIL_USER=your.email@gmail.com

# Gmail App Password (NOT your regular password!)
# How to get:
# 1. Enable 2-Factor Authentication on Gmail
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create app password for "Mail"
# 4. Copy 16-character password (no spaces)
EMAIL_PASS=your_16_character_app_password
EMAIL_APP_PASSWORD=your_16_character_app_password


# Bank Support Email Account (receives customer queries)
# This email will receive all support tickets from customers
BANK_SUPPORT_EMAIL=bank.support@gmail.com

# Bank Support Email App Password
BANK_EMAIL_PASS=bank_16_character_app_password


# ============================================
# IMAP CONFIGURATION (For Auto Email Reading)
# ============================================

# Gmail IMAP Settings (default for Gmail)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993

# For other email providers:
# Outlook: imap-mail.outlook.com, port 993
# Yahoo: imap.mail.yahoo.com, port 993


# ============================================
# PAYMENT GATEWAY (Optional - Razorpay)
# ============================================

# Razorpay API Credentials
# Get from: https://dashboard.razorpay.com/app/keys
# Leave blank if not using payment gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key


# ============================================
# FRONTEND URL (For CORS - Optional)
# ============================================

# Frontend URL (if hosting on different domain)
# Leave as default for local development
FRONTEND_URL=http://localhost:3000


# ============================================
# LOGGING & DEBUG (Optional)
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed error logging
DEBUG_MODE=false


# ============================================
# NOTES & REMINDERS
# ============================================
# 
# ✅ SECURITY CHECKLIST:
# - [ ] Changed JWT_SECRET from default
# - [ ] Using Gmail App Passwords (not regular passwords)
# - [ ] Database password is strong
# - [ ] .env file is in .gitignore
# - [ ] Never share .env file publicly
# 
# ✅ GMAIL SETUP:
# 1. Enable 2-Factor Authentication
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use App Password in EMAIL_PASS (not your Gmail password)
# 4. Enable IMAP: Settings → Forwarding and POP/IMAP → Enable IMAP
# 
# ✅ DATABASE SETUP:
# - Run database_schema_biometric.sql
# - Run database_schema_tickets.sql
# - Verify tables created: users, transactions, support_tickets, etc.
# 
# ✅ SERVICE PORTS:
# Make sure these ports are available:
# - 3000 (Frontend)
# - 5000 (Backend)
# - 5001 (Voice Service)
# - 5002 (Biometric Service)
# - 5003 (Sign Language API)
# 
# ============================================
